{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "evaluate: dev + абляция",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": ["--data", "data", "--ablation"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "evaluate: dev",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "args": ["--data", "data"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "demo: отклонённые платежи",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo.py",
      "args": [
        "--data",
        "data",
        "--query",
        "Найди уведомления об отклонённых платежах, полученные 29 января 2028 года.",
        "--user",
        "box-a971835ab404",
        "--date",
        "2028-01-30",
        "--k",
        "5"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "unittest: все тесты",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
